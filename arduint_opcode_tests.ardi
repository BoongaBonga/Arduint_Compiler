// ============================================================
// ARDUINT OPCODE TEST SUITE
// Tests scanner + parser code generation through source programs.
// Run each section independently if your VM stops after errors.
// ============================================================


// ------------------------------------------------------------
// 1. CONSTANTS, PRINT, POP, RETURN
// OP_CONSTANT_8, OP_PRINT, OP_POP, OP_RETURN
// ------------------------------------------------------------

print 0
print 1
print 255
print 256
print 65535
print true
print false
print null
print "hello from Arduint"

// Expression statements should discard their result with OP_POP.
123
"discard me"
true


// OP_CONSTANT_16: push enough distinct constants to exceed index 255.
// The printed values are intentionally uninteresting; inspect the bytecode
// and confirm that constants with indices >= 256 use OP_CONSTANT_16.
