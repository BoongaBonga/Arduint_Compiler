// 2. ARITHMETIC
// OP_ADD, OP_SUBTRACT, OP_MULTIPLY, OP_DIVIDE,
// OP_MODULO, OP_NEGATE, OP_POWER
// ------------------------------------------------------------

print 10 + 5
print 10 - 5
print 10 * 5
print 10 / 5
print 10 % 3
print -10
print 2 ^ 3
print 2 ^ 3 ^ 2
print (2 + 3) * 4
print 20 / (2 + 3)


// ------------------------------------------------------------
// 3. BITWISE OPERATIONS
// OP_AND, OP_OR, OP_XOR, OP_NOT
// ------------------------------------------------------------

print 6 & 3
print 6 | 3
print 6 xor 3
print !true
print !false


// ------------------------------------------------------------
// 4. COMPARISONS
// OP_EQUALS, OP_NOT_EQUALS, OP_GREATER,
// OP_GREATER_OR_EQUAL, OP_LESS, OP_LESS_OR_EQUAL
// ------------------------------------------------------------

print 5 == 5
print 5 == 6
print 5 != 6
print 5 != 5
print 7 > 3
print 3 > 7
print 7 >= 7
print 7 >= 8
print 3 < 7
print 7 < 3
print 7 <= 7
print 8 <= 7


// ------------------------------------------------------------
// 5. LOGICAL OPERATIONS / SHORT-CIRCUIT JUMPS
// OP_AND_AND, OP_OR_OR, OP_JUMP_IF_FALSE, OP_JUMP
// ------------------------------------------------------------

print true && true
print true && false
print false && true
print false && false

print true || true
print true || false
print false || true
print false || false

// These also test short-circuiting.
// The right side should not be evaluated when short-circuited.
print false && (1 / 0)
print true || (1 / 0)


// ------------------------------------------------------------
// 6. GLOBAL VARIABLES
// OP_GET_GLOBAL, OP_SET_GLOBAL
// ------------------------------------------------------------

globalValue = 10
print globalValue

globalValue = 20
print globalValue

globalValue += 5
print globalValue

globalValue -= 3
print globalValue

globalValue *= 2
print globalValue

globalValue /= 2
print globalValue

globalValue %= 4
print globalValue


// ------------------------------------------------------------
// 7. LOCAL VARIABLES
// OP_GET_LOCAL, OP_SET_LOCAL, OP_POP
// ------------------------------------------------------------

{
    localValue = 10
    print localValue

    localValue = 25
    print localValue

    localValue += 5
    print localValue

    {
        innerValue = 99
        print innerValue
        print localValue
    }

    // innerValue should have been popped when the inner scope ended.
    print localValue
}

// localValue should have been popped when the outer scope ended.
// Do not read it here: that should be a compile-time error.


// ------------------------------------------------------------
// 8. IF / ELSE
// OP_JUMP_IF_FALSE, OP_JUMP, OP_POP
// ------------------------------------------------------------

if true then
    print 100
else
    print 200

if false then
    print 300
else
    print 400

if 10 > 5 then
    print "comparison condition is true"
else
    print "comparison condition is false"


// ------------------------------------------------------------
// 9. WHILE LOOP
// OP_JUMP_IF_FALSE, OP_LOOP, OP_POP
// ------------------------------------------------------------

counter = 0
while counter < 3 {
    print counter
    counter += 1
}


// ------------------------------------------------------------
// 10. DO-WHILE LOOP
// OP_JUMP_IF_FALSE, OP_LOOP, OP_POP
// ------------------------------------------------------------

do {
    print "do-while iteration"
    counter -= 1
} while counter > 0


// ------------------------------------------------------------
// 11. FOR LOOP
// OP_JUMP, OP_JUMP_IF_FALSE, OP_LOOP,
// OP_GET_LOCAL, OP_SET_LOCAL, OP_POP
// ------------------------------------------------------------

for (i = 0; i < 3; i += 1) {
    print i
}


// ------------------------------------------------------------
// 12. LOOP, BREAK AND CONTINUE
// OP_LOOP, OP_JUMP
// ------------------------------------------------------------

// A loop with a break.
counter = 0
loop {
    counter += 1
    if counter == 3 then
        break
    print counter
}

// A loop with continue.
counter = 0
loop {
    counter += 1

    if counter < 3 then
        continue

    print counter

    if counter == 4 then
        break
}


// ------------------------------------------------------------
// 13. SWITCH / CASE
// OP_CASE, OP_JUMP_IF_FALSE, OP_JUMP, OP_POP
// ------------------------------------------------------------

switch 2 {
    case 1:
        print "case 1"
    case 2:
        print "case 2"
    case 3:
        print "case 3"
}

// Default branch.
switch 99 {
    case 1:
        print "one"
    case 2:
        print "two"
    default:
        print "default branch"
}


// ------------------------------------------------------------
// 14. END OF PROGRAM
// OP_RETURN is emitted by the parser after all statements.
// ------------------------------------------------------------
